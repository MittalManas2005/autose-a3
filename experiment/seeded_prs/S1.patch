diff --git a/docs/changelog.md b/docs/changelog.md
index cba971a..8ffed89 100644
--- a/docs/changelog.md
+++ b/docs/changelog.md
@@ -16,6 +16,9 @@ See the [Contributing Guide](contributing.md) for details.
 
 ### Fixed
 
+* Fix a crash in the `toc` extension when a heading has a valueless `id`
+  attribute from `attr_list`, such as `# Heading {: id }`. The heading now gets
+  the generated id, like a heading without an `id`.
 * Support automatic links with URL schemes other than HTTP and FTP, such as
   `<ssh://example.org>` (#1244).
 * Fix quadratic-time id generation in the `toc` extension when many headers
diff --git a/markdown/extensions/toc.py b/markdown/extensions/toc.py
index ba65225..261f2af 100644
--- a/markdown/extensions/toc.py
+++ b/markdown/extensions/toc.py
@@ -400,7 +400,10 @@ class TocTreeprocessor(Treeprocessor):
                 name = strip_tags(innerhtml)
 
                 # Do not override pre-existing ids
-                if "id" not in el.attrib:
+                if not el.attrib.get("id"):
+                    # The `attr_list` extension writes bare attributes with a
+                    # value of None. A valueless id is no id at all, so a slug
+                    # is generated for it like for any other id-less heading.
                     el.attrib["id"] = unique(self.slugify(html.unescape(name), self.sep), used_ids, id_counters)
 
                 data_toc_label = ''
