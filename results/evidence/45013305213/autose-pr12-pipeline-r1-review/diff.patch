+    def test_ref_link_code_span_text(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                [`code`][ref]
+
+                [ref]: /url
+                """
+            ),
+            """<p><a href="/url"><code>code</code></a></p>"""
+        )
+
+    def test_ref_link_code_span_short(self):
