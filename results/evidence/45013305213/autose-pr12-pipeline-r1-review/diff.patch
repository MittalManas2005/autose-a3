+class TestCodeSpanLinkAcceptance(TestCase):
+    """Acceptance tests for links whose text contains a code span (issue #7)."""
+
+    def test_ac_fr_001_1_reference_code_span_label_becomes_link(self):
+        """`AC-FR-001-1`: a reference link with a code span label renders as a link."""
+
+        html = markdown.markdown('[`code`][ref]\n\n[ref]: /url')
+        self.assertIn('<a href="/url"><code>code</code></a>', html)
+
+    def test_ac_fr_001_2_short_reference_code_span_label_becomes_link(self):
+        """`AC-FR-001-2`: a short reference link with a code span label renders as a link."""
+
+        html = markdown.markdown('[`code`]\n\n[`code`]: /url')
+        self.assertIn('<a href="/url"><code>code</code></a>', html)
+
+    def test_ac_fr_002_1_inline_code_span_text_still_links(self):
+        """`AC-FR-002-1`: an inline link with a code span in its text still renders as a link."""
+
+        html = markdown.markdown('[`code`](/url)')
+        self.assertIn('<a href="/url"><code>code</code></a>', html)
+
+    def test_ac_fr_002_2_reference_plain_text_still_links(self):
+        """`AC-FR-002-2`: a reference link with plain text still renders as a link."""
+
+        html = markdown.markdown('[text][ref]\n\n[ref]: /url')
+        self.assertIn('<a href="/url">text</a>', html)
+
+    def test_ac_nfr_001_1_code_span_in_link_text_is_escaped(self):
+        """`AC-NFR-001-1`: HTML in a code span inside link text is escaped."""
+
+        html = markdown.markdown('[`<b>x</b>`](/url)')
+        self.assertIn('<code>&lt;b&gt;x&lt;/b&gt;</code>', html)
