+    def raw_label(self, text: str) -> str:
+        """
+        Return the label `text` with code span placeholders replaced by their raw Markdown source.
+
+        Reference definitions are stored under their raw text, so the label must be
+        compared in the same form. Placeholders without a recorded source are left unchanged.
+        """
+        try:
+            source = self.md.treeprocessors['inline'].stashed_source
+        except KeyError:  # pragma: no cover
+            return text
+
+        def get_source(m):
+            return source.get(m.group(1), m.group(0))
+
+        return util.INLINE_PLACEHOLDER_RE.sub(get_source, text)
