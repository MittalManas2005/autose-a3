diff --git a/docs/changelog.md b/docs/changelog.md
index cba971a..d449ff4 100644
--- a/docs/changelog.md
+++ b/docs/changelog.md
@@ -16,6 +16,9 @@ See the [Contributing Guide](contributing.md) for details.
 
 ### Fixed
 
+* Fix a crash in the `toc` extension when a heading has a `data-toc-label`
+  attribute with no value and `attr_list` is enabled. The empty label is now
+  ignored, so the heading text is used in the table of contents.
 * Support automatic links with URL schemes other than HTTP and FTP, such as
   `<ssh://example.org>` (#1244).
 * Fix quadratic-time id generation in the `toc` extension when many headers
diff --git a/markdown/extensions/toc.py b/markdown/extensions/toc.py
index ba65225..925c061 100644
--- a/markdown/extensions/toc.py
+++ b/markdown/extensions/toc.py
@@ -405,9 +405,12 @@ class TocTreeprocessor(Treeprocessor):
 
                 data_toc_label = ''
                 if 'data-toc-label' in el.attrib:
-                    data_toc_label = run_postprocessors(unescape(el.attrib['data-toc-label']), self.md)
-                    # Overwrite name with sanitized value of `data-toc-label`.
-                    name = escape_cdata(strip_tags(data_toc_label))
+                    label = el.attrib['data-toc-label']
+                    # `attr_list` stores a valueless attribute as `None`: treat it as empty, keeping the heading text.
+                    if label is not None:
+                        data_toc_label = run_postprocessors(unescape(label), self.md)
+                        # Overwrite name with sanitized value of `data-toc-label`.
+                        name = escape_cdata(strip_tags(data_toc_label))
                     # Remove the data-toc-label attribute as it is no longer needed
                     del el.attrib['data-toc-label']
 
