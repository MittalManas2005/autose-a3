diff --git a/tests/test_cli_tab_length.py b/tests/test_cli_tab_length.py
new file mode 100644
index 0000000..ea1e68e
--- /dev/null
+++ b/tests/test_cli_tab_length.py
@@ -0,0 +1,129 @@
+"""
+Acceptance tests for issue #6: command line option `--tab_length`.
+
+These tests run the real command line (`python -m markdown`) in a subprocess
+and compare its standard output with the library API.
+"""
+
+import os
+import subprocess
+import sys
+import unittest
+from xml.etree import ElementTree as etree
+
+import markdown
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+SOURCE = "- a\n\n  - b\n"
+SOURCE_BYTES = SOURCE.encode('utf-8')
+
+
+def run_cli(args):
+    """ Run `python -m markdown` with `args`, feeding `SOURCE` on stdin. """
+    return subprocess.run(
+        [sys.executable, '-m', 'markdown'] + args,
+        input=SOURCE_BYTES,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=REPO_ROOT,
+        timeout=120,
+    )
+
+
+def own_text(li):
+    """ Text of a `li` element, excluding the text of nested lists. """
+    parts = [li.text or '']
+    parts.extend(p.text or '' for p in li.findall('p'))
+    return ' '.join(parts).strip()
+
+
+def find_item(root, text):
+    """ Return the single `li` element whose own text is `text`. """
+    matches = [li for li in root.iter('li') if own_text(li) == text]
+    assert len(matches) == 1, 'expected one li with text %r, found %d' % (text, len(matches))
+    return matches[0]
+
+
+def is_descendant(child, ancestor):
+    """ True if `child` is nested (at any depth) inside `ancestor`. """
+    return any(el is child for el in ancestor.iter('li') if el is not ancestor)
+
+
+class TestTabLengthCliOption(unittest.TestCase):
+    """ Acceptance criteria for issue #6. """
+
+    def test_ac_fr_001_1_equals_form_is_accepted(self):
+        """AC-FR-001-1: `python -m markdown --tab_length=2` exits 0 and writes HTML to stdout."""
+        result = run_cli(['--tab_length=2'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        self.assertTrue(result.stdout.strip(), 'expected HTML on stdout')
+
+    def test_ac_fr_001_2_space_form_is_accepted(self):
+        """AC-FR-001-2: `python -m markdown --tab_length 2` exits 0 and writes HTML to stdout."""
+        result = run_cli(['--tab_length', '2'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        self.assertTrue(result.stdout.strip(), 'expected HTML on stdout')
+
+    def test_ac_fr_002_1_equals_form_matches_library(self):
+        """AC-FR-002-1: `--tab_length=2` output equals `markdown.markdown(text, tab_length=2)`."""
+        result = run_cli(['--tab_length=2'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        expected = markdown.markdown(SOURCE, tab_length=2)
+        self.assertEqual(result.stdout.decode('utf-8'), expected)
+
+    def test_ac_fr_002_2_space_form_matches_library(self):
+        """AC-FR-002-2: `--tab_length 2` output equals `markdown.markdown(text, tab_length=2)`."""
+        result = run_cli(['--tab_length', '2'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        expected = markdown.markdown(SOURCE, tab_length=2)
+        self.assertEqual(result.stdout.decode('utf-8'), expected)
+
+    def test_ac_fr_002_3_item_b_nested_in_item_a(self):
+        """AC-FR-002-3: with `--tab_length=2`, the `li` for `b` is a descendant of the `li` for `a`."""
+        result = run_cli(['--tab_length=2'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        root = etree.fromstring('<div>' + result.stdout.decode('utf-8') + '</div>')
+        item_a = find_item(root, 'a')
+        item_b = find_item(root, 'b')
+        self.assertTrue(is_descendant(item_b, item_a), 'b should be nested inside a')
+
+    def test_ac_fr_003_1_output_unchanged_without_option(self):
+        """AC-FR-003-1: without `--tab_length`, output equals the library default and `b` is not nested."""
+        result = run_cli([])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        stdout = result.stdout.decode('utf-8')
+        self.assertEqual(stdout, markdown.markdown(SOURCE))
+        root = etree.fromstring('<div>' + stdout + '</div>')
+        item_a = find_item(root, 'a')
+        item_b = find_item(root, 'b')
+        self.assertFalse(is_descendant(item_b, item_a), 'b should not be nested with default tab length')
+
+    def test_ac_fr_004_1_help_lists_option(self):
+        """AC-FR-004-1: `python -m markdown --help` output contains `--tab_length`."""
+        result = subprocess.run(
+            [sys.executable, '-m', 'markdown', '--help'],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            cwd=REPO_ROOT,
+            timeout=120,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        self.assertIn('--tab_length', result.stdout.decode('utf-8'))
+
+    def test_ac_fr_005_1_non_integer_value_rejected(self):
+        """AC-FR-005-1: `python -m markdown --tab_length abc` exits non-zero and names `--tab_length`."""
+        result = run_cli(['--tab_length', 'abc'])
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn('--tab_length', result.stderr.decode('utf-8', 'replace'))
+
+    def test_ac_nfr_001_1_existing_output_format_preserved(self):
+        """AC-NFR-001-1: `python -m markdown -o html` output equals `markdown.markdown(text, output_format='html')`."""
+        result = run_cli(['-o', 'html'])
+        self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        expected = markdown.markdown(SOURCE, output_format='html')
+        self.assertEqual(result.stdout.decode('utf-8'), expected)
+
+
+if __name__ == '__main__':
+    unittest.main()
