@@ -1085,6 +1085,64 @@ class TestTOC(TestCase):
             extensions=['toc', 'attr_list']
         )
 
+    def test_ac_fr_001_1_valueless_id_no_error(self):
+        """AC-FR-001-1: a heading with `{: id }` converts without an exception (issue #3)."""
+        import markdown
+        output = markdown.markdown('# Heading {: id }', extensions=['toc', 'attr_list'])
+        self.assertIsInstance(output, str)
+        self.assertIn('Heading', output)
+
+    def test_ac_fr_001_2_valueless_id_generated(self):
+        """AC-FR-001-2: a heading with `{: id }` gets the auto-generated id (issue #3)."""
+        self.assertMarkdownRenders(
+            '# Heading {: id }',
+            '<h1 id="heading">Heading</h1>',
+            extensions=['toc', 'attr_list']
+        )
+
+    def test_ac_fr_001_3_valueless_id_in_toc(self):
+        """AC-FR-001-3: a heading with `{: id }` appears in the table of contents (issue #3)."""
+        self.assertMarkdownRenders(
+            '# Heading {: id }',
+            '<h1 id="heading">Heading</h1>',
+            expected_attrs={
+                'toc': (
+                    '<div class="toc">\n'
+                    '<ul>\n'
+                    '<li><a href="#heading">Heading</a></li>\n'
+                    '</ul>\n'
+                    '</div>\n'
+                ),
+                'toc_tokens': [
+                    {
+                        'level': 1,
+                        'id': 'heading',
+                        'name': 'Heading',
+                        'html': 'Heading',
+                        'data-toc-label': '',
+                        'children': []
+                    }
+                ]
+            },
+            extensions=['toc', 'attr_list']
+        )
+
+    def test_ac_fr_002_1_explicit_id_preserved(self):
+        """AC-FR-002-1: an explicit id set with `{: id="intro" }` is kept unchanged (issue #3)."""
+        self.assertMarkdownRenders(
+            '# Heading {: id="intro" }',
+            '<h1 id="intro">Heading</h1>',
+            extensions=['toc', 'attr_list']
+        )
+
+    def test_ac_fr_003_1_empty_string_id_generated(self):
+        """AC-FR-003-1: a heading with `{: id="" }` gets the auto-generated id (issue #3)."""
+        self.assertMarkdownRenders(
+            '# Heading {: id="" }',
+            '<h1 id="heading">Heading</h1>',
+            extensions=['toc', 'attr_list']
+        )
+
