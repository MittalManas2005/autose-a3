@@ -0,0 +1,112 @@
+"""
+Acceptance tests for issue #4: fenced code blocks with `linenums`, `guess_lang` or `noclasses`
+crash the conversion when `codehilite` is not enabled.
+"""
+
+import unittest
+
+import markdown
+from markdown.test_tools import TestCase
+
+
+class TestIssue4CodehiliteOnlyOptionsWithoutCodehilite(TestCase):
+    """ Acceptance criteria AC-FR-001-*, AC-FR-002-1, AC-NFR-001-*, AC-NFR-002-1 (no `codehilite`). """
+
+    extensions = ['fenced_code', 'attr_list']
+
+    def test_ac_fr_001_1_linenums_flag_is_ignored(self):
+        """AC-FR-001-1: `linenums` flag without `codehilite` is ignored and the block renders as if absent."""
+        self.assertMarkdownRenders(
+            '``` { .python linenums }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_fr_001_2_linenums_true_is_ignored(self):
+        """AC-FR-001-2: `linenums=true` without `codehilite` is ignored and the block renders as if absent."""
+        self.assertMarkdownRenders(
+            '``` { .python linenums=true }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_fr_001_3_linenums_quoted_value_is_ignored(self):
+        """AC-FR-001-3: `linenums="1"` without `codehilite` is ignored and the block renders as if absent."""
+        self.assertMarkdownRenders(
+            '``` { .python linenums="1" }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_fr_001_4_guess_lang_and_noclasses_are_ignored(self):
+        """AC-FR-001-4: `guess_lang noclasses` without `codehilite` are ignored and the block renders as if absent."""
+        self.assertMarkdownRenders(
+            '``` { .python guess_lang noclasses }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_fr_001_5_linenums_false_is_ignored(self):
+        """AC-FR-001-5: `linenums=false` without `codehilite` is ignored and the block renders as if absent."""
+        self.assertMarkdownRenders(
+            '``` { .python linenums=false }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_fr_002_1_other_attributes_kept_on_code_element(self):
+        """AC-FR-002-1: other attributes (`data-x="y"`) stay on `<code>` while `linenums` is dropped."""
+        output = markdown.markdown(
+            '``` { .python linenums data-x="y" }\nprint(1)\n```',
+            extensions=self.extensions
+        )
+        self.assertIn('<code class="language-python" data-x="y">', output)
+        self.assertNotIn('linenums', output)
+
+    def test_ac_nfr_001_1_existing_attribute_kept_and_use_pygments_false_omitted(self):
+        """AC-NFR-001-1: `foo=bar use_pygments=False` keeps `foo="bar"` and omits `use_pygments`."""
+        self.assertMarkdownRenders(
+            '``` { .python foo=bar use_pygments=False }\n# Some python code\n```',
+            '<pre><code class="language-python" foo="bar"># Some python code\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_nfr_001_2_use_pygments_true_output_unchanged(self):
+        """AC-NFR-001-2: `foo=bar use_pygments=True` without codehilite keeps the existing output."""
+        self.assertMarkdownRenders(
+            '``` { .python foo=bar use_pygments=True }\n# Some python code\n```',
+            '<pre><code class="language-python"># Some python code\n</code></pre>',
+            extensions=self.extensions
+        )
+
+    def test_ac_nfr_001_3_linenums_without_attr_list_unchanged(self):
+        """AC-NFR-001-3: with `fenced_code` only (no `attr_list`), `linenums` is not rendered."""
+        self.assertMarkdownRenders(
+            '``` { .python linenums }\nprint(1)\n```',
+            '<pre><code class="language-python">print(1)\n</code></pre>',
+            extensions=['fenced_code']
+        )
+
+    def test_ac_nfr_002_1_attribute_names_and_values_escaped(self):
+        """AC-NFR-002-1: a malicious attribute name is sanitised and its value escaped on `<code>`."""
+        self.assertMarkdownRenders(
+            '``` { .python x><svg/onload=alert(1) }\n# Some python code\n```',
+            '<pre><code class="language-python" x_svg_onload="alert(1)"># Some python code\n</code></pre>',
+            extensions=self.extensions
+        )
+
+
+class TestIssue4WithCodehilite(TestCase):
+    """ Acceptance criteria AC-FR-003-1 (`codehilite` enabled). """
+
+    def test_ac_fr_003_1_codehilite_linenums_does_not_raise(self):
+        """AC-FR-003-1: with `codehilite` enabled, `linenums` renders without an exception and non-empty output."""
+        output = markdown.markdown(
+            '``` { .python linenums }\nprint(1)\n```',
+            extensions=['codehilite', 'fenced_code']
+        )
+        self.assertTrue(output.strip())
+
+
+if __name__ == '__main__':
+    unittest.main()
